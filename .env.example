# Copy to .env for local development. No real values belong in this file.
# On AWS every variable below comes from SSM Parameter Store under
# /beldium/<staging|production>/<NAME>; see docs/aws-deployment.md.
#
# "Required" means: when ENVIRONMENT is staging or production the app refuses
# to start if this is missing (core/settings.py, REQUIRED_WHEN_DEPLOYED).

# --- Core -------------------------------------------------------------------
# local | staging | production. staging and production get identical, strict
# behaviour. Set by the task definition on AWS, not SSM.
ENVIRONMENT=local
# Required. At least 50 random characters. Signs every JWT.
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Defaults to false. The app refuses to start with DEBUG on when deployed.
DEBUG=true

# --- Hosts, origins, proxies -------------------------------------------------
# Required. Comma-separated hostnames this API answers to, e.g. api.beldium.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Required in SSM (the task will not start without the parameter). The ECS
# Express Mode URL without https://. Use pending.invalid until the service exists.
ECS_SERVICE_HOST=
# Required. Comma-separated https:// origins trusted for CSRF (Django admin).
CSRF_TRUSTED_ORIGINS=
# Required. Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5174
# Required. Origins that sign in to the compliance portal.
COMPLIANCE_PORTAL_ORIGINS=http://localhost:8080
# Required. Origins that sign in to the miner portal.
MINER_PORTAL_ORIGINS=http://localhost:5174
# Required. Origins that sign in to the logistics portal.
LOGISTICS_PORTAL_ORIGINS=http://localhost:5175
# Required. Proxies in front of the app. 1 behind the AWS load balancer, 0 locally.
NUM_PROXIES=0

# --- Database ---------------------------------------------------------------
# Required. postgres://user:password@host:5432/dbname
# Locally, leave empty to use SQLite, or use the DB_* variables below.
DATABASE_URL=
# Optional local alternative to DATABASE_URL: set DB_ENGINE=postgresql.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- Redis / Celery ---------------------------------------------------------
# Required. Celery broker and shared cache. rediss:// if ElastiCache uses TLS.
REDIS_URL=redis://localhost:6379/0
# Optional. Separate cache URL. Defaults to REDIS_URL when deployed.
CACHE_URL=
# Optional. Defaults to true locally and false when deployed (real worker).
CELERY_TASK_ALWAYS_EAGER=
# Optional. Re-raise task errors in eager mode. Default false.
CELERY_TASK_EAGER_PROPAGATES=false

# --- Email (Resend) ---------------------------------------------------------
# Required. Resend API key. Empty locally prints emails to the console.
EMAIL_HOST_PASSWORD=
# Required. Sender address.
DEFAULT_FROM_EMAIL=noreply@beldium.com
# Required. Base URL used in email links.
FRONTEND_URL=http://localhost:8080
# Optional. Only used by the SMTP fallback backend.
EMAIL_BACKEND=
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_USE_TLS=true
# Optional. Seconds before an email send gives up. Default 10.
EMAIL_TIMEOUT=10

# --- File uploads (S3) ------------------------------------------------------
# Required. Private bucket for uploads. Empty locally stores files in media/.
AWS_STORAGE_BUCKET_NAME=
# Optional. Default us-east-1.
AWS_S3_REGION_NAME=us-east-1
# Optional. Only for S3-compatible providers (R2, B2). Leave empty for AWS.
AWS_S3_ENDPOINT_URL=
# Optional. Leave empty on ECS so the task role is used. Only for running
# outside AWS, e.g. copying media off Render.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Process tuning (set in deploy/ecs/config.json, not SSM) ----------------
# Optional. gunicorn worker processes per web task. Default 3.
GUNICORN_WORKERS=3
# Optional. gunicorn request timeout in seconds. Default 90.
GUNICORN_TIMEOUT=90
# Optional. Celery worker processes per worker task. Default 2.
CELERY_CONCURRENCY=2

# --- SMS and social sign-in (currently disabled in code) ---------------------
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert
GOOGLE_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_TENANT_ID=common

# --- One-off admin commands (never set on a running service) -----------------
# Read by `manage import_legacy_users`. Old database URL, read-only.
LEGACY_DATABASE_URL=
# Read by `manage delete_test_users`. Deletes these users when run.
DELETE_TEST_USER_EMAILS=
# Read by `manage bootstrap_admin`. Creates/promotes this admin and resets its password.
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_SECRET=

# --- Render only (remove after cutover) --------------------------------------
RENDER_EXTERNAL_HOSTNAME=
