# SECRET_KEY signs every access and refresh token. Generate one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Deliberately unset here: local runs fall back to the development key in
# settings.py, and ENVIRONMENT=production refuses to start until this is set.
DEBUG=True
ENVIRONMENT=local
ALLOWED_HOSTS=localhost,127.0.0.1
# The frontend dev server (beldium-new-frontend) runs on port 8080.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173
# Set DB_ENGINE=postgresql and the DB_* values in deployed environments.
DB_ENGINE=sqlite
DB_NAME=beldium_compliance
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES=False
SENDGRID_API_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@beldium.com
FRONTEND_URL=http://localhost:8080
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_TENANT_ID=common
# Optional S3-compatible private media storage (AWS S3, R2, Backblaze B2).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
